<view class="page">
  <!-- 状态Tab -->
  <view class="status-tabs">
    <view
      class="tab {{currentTab === item.value ? 'active' : ''}}"
      wx:for="{{tabs}}"
      wx:key="value"
      bindtap="switchTab"
      data-value="{{item.value}}"
    >
      {{item.label}}
      <view class="tab-dot" wx:if="{{item.value === currentTab}}"></view>
    </view>
  </view>

  <!-- 订单列表 -->
  <scroll-view class="order-list" scroll-y bindscrolltolower="loadMore">
    <view class="order-card" wx:for="{{orders}}" wx:key="id">
      <view class="order-hd">
        <text class="order-no">订单号: {{item.order_no}}</text>
        <text class="order-status {{statusClass[item.status]}}">{{statusText[item.status]}}</text>
      </view>
      <view class="order-goods">
        <image class="goods-img" wx:for="{{item.items}}" wx:key="index" wx:for-item="g" src="{{g.product_image}}" mode="aspectFill" />
      </view>
      <view class="order-ft">
        <text class="order-total">合计: ¥{{item.total_amount / 100}}</text>
        <view class="order-actions">
          <view class="action-btn secondary" wx:if="{{item.status === 0}}" bindtap="cancelOrder" data-id="{{item.id}}">取消</view>
          <view class="action-btn primary" wx:if="{{item.status === 0}}" bindtap="payOrder" data-id="{{item.id}}">去支付</view>
          <view class="action-btn secondary" wx:if="{{item.status === 2}}" bindtap="confirmReceive" data-id="{{item.id}}">确认收货</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{loaded && orders.length === 0}}">
      <text>📦</text>
      <text class="empty-txt">暂无相关订单</text>
    </view>
    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="no-more" wx:if="{{loaded && orders.length > 0 && !hasMore}}">— 没有更多了 —</view>
  </scroll-view>
</view>
