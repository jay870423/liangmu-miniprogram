/* 订单页 */
.page { background: #f5f5f5; min-height: 100vh; }
.status-tabs { display: flex; background: #fff; padding: 0 16rpx; border-bottom: 1rpx solid #f0f0f0; position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 28rpx; color: #666; position: relative; }
.tab.active { color: #2d5a27; font-weight: 600; }
.tab-dot { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 48rpx; height: 4rpx; background: #2d5a27; border-radius: 4rpx; }
.order-list { padding: 20rpx 24rpx; display: flex; flex-direction: column; gap: 20rpx; }
.order-card { background: #fff; border-radius: 16rpx; overflow: hidden; }
.order-hd { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; }
.order-no { font-size: 22rpx; color: #888; }
.order-status { font-size: 24rpx; font-weight: 600; }
.order-status.pending { color: #ff6b00; }
.order-status.paid { color: #2d5a27; }
.order-status.shipped { color: #007aff; }
.order-status.done { color: #999; }
.order-goods { display: flex; gap: 12rpx; padding: 16rpx 24rpx; overflow-x: auto; }
.goods-img { width: 120rpx; height: 120rpx; border-radius: 8rpx; flex-shrink: 0; }
.fee-box { padding: 4rpx 24rpx 12rpx; border-top: 1rpx solid #f7f7f7; }
.fee-row { display: flex; justify-content: space-between; align-items: center; padding: 6rpx 0; font-size: 24rpx; color: #666; }
.fee-row.discount { color: #d64b35; }
.order-ft { display: flex; justify-content: space-between; align-items: center; padding: 18rpx 24rpx 22rpx; border-top: 1rpx solid #f5f5f5; }
.order-total { font-size: 28rpx; font-weight: 700; color: #1a1a1a; }
.order-actions { display: flex; gap: 12rpx; }
.action-btn { padding: 12rpx 28rpx; border-radius: 32rpx; font-size: 24rpx; }
.action-btn.primary { background: #2d5a27; color: #fff; }
.action-btn.secondary { background: #f5f5f5; color: #666; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; gap: 16rpx; font-size: 80rpx; }
.empty-txt { font-size: 28rpx; color: #999; }
.loading, .no-more { text-align: center; padding: 30rpx; font-size: 24rpx; color: #999; }
