/* 订单页 */
.page { background: #f5f5f5; min-height: 100vh; width: 100%; overflow-x: hidden; box-sizing: border-box; }
.status-tabs { display: flex; width: 100%; box-sizing: border-box; background: #fff; padding: 0 12rpx; border-bottom: 1rpx solid #f0f0f0; position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; min-width: 0; text-align: center; padding: 22rpx 0; font-size: 26rpx; color: #666; position: relative; white-space: nowrap; }
.tab.active { color: #2d5a27; font-weight: 600; }
.tab-dot { position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 48rpx; height: 4rpx; background: #2d5a27; border-radius: 4rpx; }
.order-list { width: 100%; box-sizing: border-box; padding: 18rpx 18rpx 28rpx; }
.order-card { width: 100%; box-sizing: border-box; background: #fff; border-radius: 16rpx; overflow: hidden; margin-bottom: 18rpx; box-shadow: 0 4rpx 18rpx rgba(0,0,0,0.035); }
.order-hd { display: flex; justify-content: space-between; align-items: flex-start; gap: 16rpx; padding: 20rpx 22rpx; border-bottom: 1rpx solid #f5f5f5; }
.order-no { flex: 1; min-width: 0; font-size: 22rpx; color: #888; line-height: 1.45; word-break: break-all; }
.order-status { flex-shrink: 0; max-width: 130rpx; text-align: right; font-size: 24rpx; font-weight: 600; line-height: 1.45; }
.order-status.pending { color: #ff6b00; }
.order-status.paid { color: #2d5a27; }
.order-status.shipped { color: #007aff; }
.order-status.done { color: #999; }
.order-goods { display: flex; align-items: center; gap: 16rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid #f7f7f7; box-sizing: border-box; }
.goods-img { width: 112rpx; height: 112rpx; border-radius: 10rpx; flex-shrink: 0; background: #f4f4f4; }
.goods-main { flex: 1; min-width: 0; }
.goods-name { font-size: 26rpx; color: #333; line-height: 1.35; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.goods-meta { margin-top: 12rpx; font-size: 22rpx; color: #999; }
.goods-subtotal { flex-shrink: 0; max-width: 150rpx; font-size: 24rpx; font-weight: 700; color: #333; text-align: right; word-break: break-all; }
.fee-box { padding: 10rpx 22rpx 12rpx; border-top: 1rpx solid #fafafa; box-sizing: border-box; }
.fee-row { display: flex; justify-content: space-between; align-items: center; gap: 20rpx; padding: 7rpx 0; font-size: 24rpx; color: #666; }
.fee-row text:first-child { flex-shrink: 0; }
.fee-row text:last-child { min-width: 0; text-align: right; word-break: break-all; }
.fee-row.discount { color: #d64b35; }
.order-ft { display: flex; flex-direction: column; align-items: stretch; gap: 16rpx; padding: 16rpx 22rpx 22rpx; border-top: 1rpx solid #f5f5f5; box-sizing: border-box; }
.order-total { font-size: 28rpx; font-weight: 800; color: #1a1a1a; line-height: 1.4; }
.order-actions { display: flex; justify-content: flex-end; gap: 12rpx; flex-wrap: wrap; }
.action-btn { min-width: 132rpx; box-sizing: border-box; padding: 12rpx 24rpx; border-radius: 32rpx; font-size: 24rpx; text-align: center; }
.action-btn.primary { background: #2d5a27; color: #fff; }
.action-btn.secondary { background: #f5f5f5; color: #666; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 0; gap: 16rpx; font-size: 80rpx; }
.empty-txt { font-size: 28rpx; color: #999; }
.loading, .no-more { text-align: center; padding: 30rpx; font-size: 24rpx; color: #999; }
.login-empty { margin: 120rpx 48rpx 0; padding: 64rpx 36rpx; background: #fff; border-radius: 20rpx; text-align: center; box-shadow: 0 8rpx 28rpx rgba(0,0,0,0.04); }
.login-icon { font-size: 72rpx; line-height: 1; margin-bottom: 22rpx; }
.login-title { font-size: 34rpx; font-weight: 800; color: #1a1a1a; margin-bottom: 14rpx; }
.login-desc { font-size: 26rpx; color: #888; line-height: 1.5; margin-bottom: 34rpx; }
.login-btn { display: inline-flex; align-items: center; justify-content: center; min-width: 220rpx; height: 72rpx; padding: 0 36rpx; border-radius: 40rpx; background: #2d5a27; color: #fff; font-size: 28rpx; font-weight: 700; }
.checkout-page { min-height: 100vh; padding: 20rpx 24rpx 150rpx; box-sizing: border-box; }
.checkout-section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.section-title { font-size: 28rpx; font-weight: 700; color: #1a1a1a; margin-bottom: 18rpx; }
.section-title.no-margin { margin-bottom: 0; }
.section-row-title { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 18rpx; }
.coupon-count { flex-shrink: 0; font-size: 24rpx; color: #2d5a27; }
.coupon-empty { padding: 22rpx 0; font-size: 26rpx; color: #999; text-align: center; background: #fafafa; border-radius: 12rpx; }
.coupon-list { display: flex; flex-direction: column; gap: 12rpx; }
.coupon-option { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 18rpx; border: 2rpx solid #edf0ea; border-radius: 14rpx; background: #fbfcfa; box-sizing: border-box; }
.coupon-option.active { border-color: #2d5a27; background: #f0f8ed; }
.coupon-main { flex: 1; min-width: 0; }
.coupon-name { font-size: 26rpx; font-weight: 700; color: #1a1a1a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.coupon-rule { margin-top: 8rpx; font-size: 22rpx; color: #888; }
.coupon-amount { flex-shrink: 0; font-size: 30rpx; font-weight: 800; color: #d64b35; }
.coupon-clear { align-self: flex-end; padding: 10rpx 4rpx; font-size: 24rpx; color: #2d5a27; }
.address-card { border: 1rpx solid #e7efe5; background: #fbfdfb; border-radius: 12rpx; padding: 18rpx; }
.address-top { display: flex; align-items: center; gap: 16rpx; margin-bottom: 10rpx; }
.receiver { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.phone { font-size: 26rpx; color: #666; }
.default-tag { padding: 2rpx 10rpx; border-radius: 6rpx; background: #2d5a27; color: #fff; font-size: 20rpx; }
.address-detail { font-size: 26rpx; color: #333; line-height: 1.5; }
.empty-address { padding: 28rpx; border: 1rpx dashed #cfd8cc; border-radius: 12rpx; color: #2d5a27; text-align: center; font-size: 28rpx; }
.address-list { margin-top: 16rpx; display: flex; flex-direction: column; gap: 12rpx; }
.address-option { display: flex; flex-direction: column; gap: 4rpx; padding: 16rpx; border-radius: 10rpx; background: #f7f7f7; font-size: 24rpx; color: #666; }
.address-option.active { background: #eef6ec; color: #2d5a27; }
.manage-link { margin-top: 18rpx; color: #2d5a27; font-size: 26rpx; text-align: right; }
.checkout-good { display: flex; align-items: center; gap: 18rpx; padding: 18rpx 0; border-top: 1rpx solid #f5f5f5; }
.checkout-good:first-of-type { border-top: 0; padding-top: 0; }
.checkout-img { width: 120rpx; height: 120rpx; border-radius: 10rpx; flex-shrink: 0; background: #f4f4f4; }
.checkout-good-main { flex: 1; min-width: 0; }
.checkout-good-name { font-size: 28rpx; font-weight: 600; color: #222; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.checkout-good-meta { margin-top: 14rpx; font-size: 24rpx; color: #888; }
.checkout-subtotal { font-size: 28rpx; font-weight: 700; color: #d64b35; }
.pay-row { display: flex; justify-content: space-between; align-items: center; padding-top: 18rpx; margin-top: 10rpx; border-top: 1rpx solid #f0f0f0; font-size: 32rpx; font-weight: 800; color: #1a1a1a; }
.checkout-bottom { position: fixed; left: 0; right: 0; bottom: 0; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.06); }
.bottom-total { display: flex; flex-direction: column; gap: 4rpx; font-size: 22rpx; color: #666; }
.bottom-total text:last-child { font-size: 34rpx; color: #d64b35; font-weight: 800; }
.submit-btn { min-width: 260rpx; height: 76rpx; line-height: 76rpx; text-align: center; border-radius: 40rpx; background: #2d5a27; color: #fff; font-size: 28rpx; font-weight: 700; }
.submit-btn.disabled { background: #c8d1c5; color: #fff; }
