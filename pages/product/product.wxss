/* 商品详情页 */
.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 120rpx; }
.image-swiper { height: 750rpx; background: #fff; }
.prod-img { width: 100%; height: 100%; }

.price-section { background: #fff; padding: 24rpx; }
.price-wrap { display: flex; align-items: baseline; gap: 12rpx; }
.price { font-size: 48rpx; font-weight: 700; color: #c8391d; }
.ori-price { font-size: 28rpx; color: #bbb; text-decoration: line-through; }
.sales-info { display: flex; gap: 24rpx; margin-top: 12rpx; font-size: 22rpx; color: #888; }
.sold-out { color: #c8391d; }

.name-section { background: #fff; padding: 24rpx; margin-bottom: 16rpx; }
.prod-name { font-size: 32rpx; font-weight: 700; color: #1a1a1a; display: block; }
.prod-sub { font-size: 26rpx; color: #888; margin-top: 8rpx; display: block; }

.spec-section { background: #fff; padding: 24rpx; margin-bottom: 16rpx; }
.spec-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.spec-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.spec-item {
  padding: 12rpx 24rpx; border-radius: 32rpx;
  border: 2rpx solid #e0e0e0; font-size: 26rpx; color: #666;
  background: #f8f8f8;
}
.spec-item.selected { border-color: #2d5a27; color: #2d5a27; background: #f0f9f0; }

.detail-section { background: #fff; padding: 24rpx; margin-bottom: 16rpx; }
.detail-title { font-size: 28rpx; font-weight: 600; margin-bottom: 16rpx; }
.detail-content { font-size: 28rpx; line-height: 1.8; color: #444; }
.detail-img { width: 100%; display: block; margin-top: 16rpx; }

.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center;
  background: #fff; padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}
.action-icons { display: flex; gap: 24rpx; margin-right: 16rpx; }
.action-icon { display: flex; flex-direction: column; align-items: center; gap: 2rpx; font-size: 36rpx; }
.icon-label { font-size: 18rpx; color: #888; }
.action-btns { flex: 1; display: flex; gap: 16rpx; }
.btn-add-cart, .btn-buy-now {
  flex: 1; text-align: center; padding: 22rpx 0;
  border-radius: 40rpx; font-size: 28rpx; font-weight: 600;
}
.btn-add-cart { background: #f5f0e6; color: #8B6914; }
.btn-buy-now { background: #2d5a27; color: #fff; }
