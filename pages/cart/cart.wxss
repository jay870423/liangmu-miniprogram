/* 购物车页 */
.page { background: #f5f5f5; min-height: 100vh; width: 100%; overflow-x: hidden; box-sizing: border-box; padding-bottom: 150rpx; }
.cart-list { width: 100%; box-sizing: border-box; padding: 18rpx 18rpx 24rpx; }
.cart-item { width: 100%; box-sizing: border-box; background: #fff; border-radius: 18rpx; padding: 18rpx 20rpx 20rpx; margin-bottom: 18rpx; box-shadow: 0 4rpx 18rpx rgba(0,0,0,0.035); overflow: hidden; }
.item-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.item-check { display: flex; align-items: center; gap: 10rpx; min-width: 0; color: #666; font-size: 24rpx; }
.check-icon { width: 34rpx; height: 34rpx; border-radius: 50%; border: 2rpx solid #cfd8cc; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; font-size: 24rpx; color: #fff; line-height: 1; flex-shrink: 0; }
.check-icon.checked { border-color: #2d5a27; background: #2d5a27; }
.check-label { color: #777; font-size: 24rpx; }
.item-del { flex-shrink: 0; padding: 8rpx 18rpx; border-radius: 24rpx; background: #f7f7f7; color: #999; font-size: 22rpx; }
.item-main { display: flex; align-items: flex-start; gap: 18rpx; width: 100%; box-sizing: border-box; }
.item-img { width: 148rpx; height: 148rpx; border-radius: 12rpx; flex-shrink: 0; background: #f3f3f3; }
.item-detail { flex: 1; display: flex; flex-direction: column; gap: 8rpx; min-width: 0; }
.item-name { font-size: 28rpx; font-weight: 700; color: #1a1a1a; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-all; }
.item-spec, .item-meta { font-size: 22rpx; color: #888; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-bottom { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 18rpx; padding-top: 18rpx; border-top: 1rpx solid #f5f5f5; }
.price-wrap { min-width: 0; display: flex; align-items: baseline; gap: 8rpx; }
.price-label { font-size: 22rpx; color: #999; flex-shrink: 0; }
.item-price { font-size: 30rpx; font-weight: 800; color: #c8391d; word-break: break-all; }
.qty-ctrl { flex-shrink: 0; display: flex; align-items: center; background: #f5f6f4; border-radius: 999rpx; overflow: hidden; border: 1rpx solid #edf0ea; }
.qty-btn { width: 60rpx; height: 52rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; color: #2d5a27; font-weight: 700; }
.qty-num { min-width: 58rpx; height: 52rpx; line-height: 52rpx; text-align: center; font-size: 26rpx; color: #1a1a1a; background: #fff; }

.empty-cart {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 120rpx 0; gap: 24rpx;
}
.empty-icon { font-size: 120rpx; }
.empty-txt { font-size: 28rpx; color: #999; }
.go-shop {
  background: #2d5a27; color: #fff;
  padding: 20rpx 60rpx; border-radius: 40rpx;
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 18rpx;
  background: #fff; padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  box-sizing: border-box;
}
.all-check { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: #555; white-space: nowrap; }
.total-wrap { min-width: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 4rpx; }
.total-line { max-width: 100%; display: flex; align-items: baseline; gap: 6rpx; }
.total-label { flex-shrink: 0; font-size: 24rpx; color: #666; }
.total-price { min-width: 0; font-size: 34rpx; font-weight: 800; color: #c8391d; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.selected-tip { font-size: 20rpx; color: #999; }
.checkout-btn {
  background: #2d5a27; color: #fff;
  min-width: 148rpx; height: 72rpx; line-height: 72rpx; text-align: center; padding: 0 24rpx; border-radius: 40rpx;
  font-size: 28rpx; font-weight: 600;
  box-sizing: border-box; white-space: nowrap;
}
.checkout-btn.disabled { background: #ccc; }
