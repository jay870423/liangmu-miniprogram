/* 购物车页 */
.page { background: #f5f5f5; min-height: 100vh; padding-bottom: 120rpx; }
.cart-list { padding: 20rpx 24rpx; display: flex; flex-direction: column; gap: 16rpx; }
.cart-item {
  display: flex; align-items: center; gap: 16rpx;
  background: #fff; border-radius: 16rpx; padding: 20rpx;
}
.item-check { padding: 8rpx; }
.check-icon { font-size: 36rpx; }
.item-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; flex-shrink: 0; }
.item-detail { flex: 1; display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.item-name { font-size: 26rpx; font-weight: 600; color: #1a1a1a; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.item-spec { font-size: 22rpx; color: #888; }
.item-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
.item-price { font-size: 28rpx; font-weight: 700; color: #c8391d; }
.qty-ctrl { display: flex; align-items: center; background: #f5f5f5; border-radius: 8rpx; overflow: hidden; }
.qty-btn { width: 56rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; color: #666; }
.qty-num { width: 56rpx; text-align: center; font-size: 26rpx; }
.item-del { padding: 8rpx; }

.empty-cart {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  padding: 120rpx 0; gap: 24rpx;
}
.empty-icon { font-size: 120rpx; }
.empty-txt { font-size: 28rpx; color: #999; }
.go-shop {
  background: #2d5a27; color: #fff;
  padding: 20rpx 60rpx; border-radius: 40rpx;
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  display: flex; align-items: center; justify-content: space-between;
  background: #fff; padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
}
.all-check { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; }
.total-wrap { display: flex; align-items: baseline; gap: 6rpx; }
.total-label { font-size: 26rpx; color: #666; }
.total-price { font-size: 34rpx; font-weight: 700; color: #c8391d; }
.checkout-btn {
  background: #2d5a27; color: #fff;
  padding: 20rpx 40rpx; border-radius: 40rpx;
  font-size: 28rpx; font-weight: 600;
}
.checkout-btn.disabled { background: #ccc; }
