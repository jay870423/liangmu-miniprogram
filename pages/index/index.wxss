/* === 首页样式 === */
.page {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 顶部搜索栏 */
.top-search {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #2d5a27;
  gap: 16rpx;
}
.search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 32rpx;
  padding: 14rpx 24rpx;
  gap: 10rpx;
}
.search-bar .icon { font-size: 26rpx; }
.search-bar .txt { font-size: 26rpx; color: #999; }
.msg-btn {
  position: relative;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(255,255,255,0.16);
  color: #fff;
  font-size: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.msg-badge {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 18rpx;
  background: #e53935;
  color: #fff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
  border: 3rpx solid #2d5a27;
  box-sizing: border-box;
}

/* 轮播图 */
.banner {
  width: 100%;
  height: 420rpx;
  background: #f5f5f5;
}
.banner-frame {
  position: relative;
  width: calc(100% - 24rpx);
  height: 408rpx;
  margin: 0 12rpx 12rpx;
  border-radius: 0 0 18rpx 18rpx;
  overflow: hidden;
  background: #f2f4ee;
}
.banner-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  filter: blur(18rpx);
  opacity: 0.28;
  transform: scale(1.08);
}
.banner-img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  display: block;
}

/* 分类4宫格 */
.cate-4grid {
  display: flex;
  flex-wrap: wrap;
  background: #fff;
  padding: 24rpx 16rpx;
  gap: 8rpx;
  margin-bottom: 16rpx;
}
.cate-cell {
  width: calc(50% - 8rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0;
  background: #f8f9f5;
  border-radius: 16rpx;
  gap: 10rpx;
}
.cate-icon-wrap {
  width: 72rpx; height: 72rpx;
  background: #fff;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.08);
}
.cate-icon { width: 48rpx; height: 48rpx; display: block; }
.cate-icon-placeholder { font-size: 40rpx; line-height: 1; }
.cate-name { font-size: 24rpx; color: #333; font-weight: 600; }

/* 区块通用 */
.section { margin: 0 24rpx 24rpx; }
.section-hd {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0 16rpx;
}
.section-title { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.section-more { display: flex; align-items: center; font-size: 24rpx; color: #999; }
.ar { font-size: 28rpx; margin-left: 4rpx; }

/* 新品横向滚动 */
.h-scroll { width: 100%; white-space: nowrap; }
.h-scroll-inner { display: inline-flex; gap: 16rpx; padding: 4rpx 0; }
.prod-card {
  width: 220rpx;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  flex-shrink: 0;
}
.prod-card.empty-card {
  width: 220rpx; height: 300rpx;
  display: flex; align-items: center; justify-content: center;
  background: #f0f0f0;
}
.prod-card.empty-card text { font-size: 24rpx; color: #999; }
.prod-img { width: 220rpx; height: 220rpx; }
.prod-info { padding: 12rpx 14rpx 14rpx; }
.prod-name {
  font-size: 24rpx; color: #1a1a1a;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  min-height: 64rpx;
}
.prod-price-row { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.price { font-size: 28rpx; font-weight: 700; color: #c8391d; }
.sold { font-size: 20rpx; color: #999; }

/* 推荐2列网格 */
.prod-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.g-cell {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.g-img { width: 100%; height: 320rpx; }
.g-info { padding: 14rpx; }
.g-name {
  font-size: 26rpx; font-weight: 600; color: #1a1a1a;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  min-height: 68rpx;
}
.g-sub { font-size: 22rpx; color: #888; margin-top: 4rpx; }
.g-bottom { display: flex; align-items: baseline; gap: 8rpx; margin-top: 8rpx; }
.g-price { font-size: 30rpx; font-weight: 700; color: #c8391d; }
.g-ori { font-size: 22rpx; color: #bbb; text-decoration: line-through; }
.g-sales { display: flex; justify-content: space-between; margin-top: 6rpx; font-size: 20rpx; color: #999; }
