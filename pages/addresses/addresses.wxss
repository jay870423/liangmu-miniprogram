.page { min-height: 100vh; background: #f5f5f5; padding-bottom: 120rpx; }
.list { height: calc(100vh - 120rpx); }
.address-card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
}
.top { display: flex; align-items: center; gap: 16rpx; }
.name { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.phone { font-size: 26rpx; color: #555; }
.tag { padding: 4rpx 12rpx; background: #eaf6e8; color: #2d5a27; border-radius: 16rpx; font-size: 20rpx; }
.addr { display: block; margin-top: 14rpx; color: #333; font-size: 26rpx; line-height: 1.5; }
.actions { display: flex; align-items: center; gap: 28rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid #f0f0f0; }
.spacer { flex: 1; }
.link { font-size: 24rpx; color: #2d5a27; }
.danger { color: #d64242; }
.empty { display: flex; flex-direction: column; align-items: center; gap: 16rpx; padding: 120rpx 0; color: #999; }
.empty-icon { font-size: 92rpx; }
.empty-text { font-size: 28rpx; }
.form { margin: 20rpx 24rpx; background: #fff; border-radius: 16rpx; overflow: hidden; }
.field { display: flex; align-items: center; min-height: 96rpx; padding: 0 24rpx; border-bottom: 1rpx solid #f3f3f3; }
.field.area { align-items: flex-start; padding-top: 24rpx; }
.label { width: 150rpx; color: #333; font-size: 26rpx; flex-shrink: 0; }
input { flex: 1; font-size: 26rpx; }
textarea { flex: 1; min-height: 150rpx; font-size: 26rpx; }
.region-field { position: relative; }
.region-value { flex: 1; min-width: 0; color: #1f2933; font-size: 26rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.region-value.placeholder { color: #b8b8b8; }
.chevron { margin-left: 16rpx; color: #9aa0a6; font-size: 40rpx; line-height: 1; }
.switch-row { display: flex; align-items: center; justify-content: space-between; padding: 24rpx; font-size: 26rpx; color: #333; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; display: flex; gap: 16rpx; padding: 20rpx 24rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06); }
.btn { flex: 1; height: 80rpx; border-radius: 40rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: 600; }
.btn.primary { background: #2d5a27; color: #fff; }
.btn.ghost { background: #f3f5f2; color: #333; }
.btn.full { flex: 1; }
