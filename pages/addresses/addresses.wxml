<view class="page">
  <scroll-view class="list" scroll-y wx:if="{{!showForm}}">
    <view class="address-card" wx:for="{{items}}" wx:key="id">
      <view class="top">
        <text class="name">{{item.receiver_name}}</text>
        <text class="phone">{{item.phone}}</text>
        <text class="tag" wx:if="{{item.is_default}}">默认</text>
      </view>
      <text class="addr">{{item.province}}{{item.city}}{{item.district}} {{item.detail_address}}</text>
      <view class="actions">
        <view class="link" bindtap="setDefault" data-id="{{item.id}}" wx:if="{{!item.is_default}}">设为默认</view>
        <view class="spacer"></view>
        <view class="link" bindtap="editItem" data-index="{{index}}">编辑</view>
        <view class="link danger" bindtap="deleteItem" data-id="{{item.id}}">删除</view>
      </view>
    </view>
    <view class="empty" wx:if="{{loaded && items.length === 0}}">
      <text class="empty-icon">⌖</text>
      <text class="empty-text">暂无收货地址</text>
    </view>
  </scroll-view>

  <view class="form" wx:if="{{showForm}}">
    <view class="field">
      <text class="label">收货人</text>
      <input value="{{form.receiver_name}}" data-field="receiver_name" bindinput="onInput" placeholder="请输入姓名" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input value="{{form.phone}}" data-field="phone" bindinput="onInput" placeholder="请输入手机号" type="number" />
    </view>
    <view class="field">
      <text class="label">省份</text>
      <input value="{{form.province}}" data-field="province" bindinput="onInput" placeholder="如：海南省" />
    </view>
    <view class="field">
      <text class="label">城市</text>
      <input value="{{form.city}}" data-field="city" bindinput="onInput" placeholder="如：海口市" />
    </view>
    <view class="field">
      <text class="label">区县</text>
      <input value="{{form.district}}" data-field="district" bindinput="onInput" placeholder="如：美兰区" />
    </view>
    <view class="field area">
      <text class="label">详细地址</text>
      <textarea value="{{form.detail_address}}" data-field="detail_address" bindinput="onInput" placeholder="街道、门牌号等" />
    </view>
    <view class="switch-row">
      <text>设为默认地址</text>
      <switch checked="{{form.is_default}}" color="#2d5a27" bindchange="onDefaultChange" />
    </view>
  </view>

  <view class="bottom-bar">
    <view class="btn ghost" wx:if="{{showForm}}" bindtap="closeForm">取消</view>
    <view class="btn primary" wx:if="{{showForm}}" bindtap="saveForm">保存地址</view>
    <view class="btn primary full" wx:else bindtap="addItem">+ 新增收货地址</view>
  </view>
</view>
