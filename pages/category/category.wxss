/* 分类页 */
.page { display: flex; height: 100vh; background: #f5f5f5; }

.left-panel { width: 180rpx; background: #f8f8f8; }
.left-scroll { height: 100vh; }
.cate-item {
  display: flex; align-items: center; gap: 8rpx;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid #eee;
}
.cate-item.active { background: #fff; color: #2d5a27; font-weight: 600; }
.cate-item.active::before {
  content: ''; position: absolute; left: 0;
  width: 4rpx; height: 48rpx; background: #2d5a27;
}
.cate-icon { font-size: 28rpx; }
.cate-name { font-size: 26rpx; }

.right-panel { flex: 1; display: flex; flex-direction: column; }
.right-hd {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 20rpx 16rpx;
  background: #fff; border-bottom: 1rpx solid #f0f0f0;
}
.right-title { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.right-count { font-size: 22rpx; color: #999; }

.right-scroll { flex: 1; }
.product-list { padding: 16rpx 20rpx; display: flex; flex-direction: column; gap: 16rpx; }
.list-item {
  display: flex; align-items: center; gap: 16rpx;
  background: #fff; border-radius: 16rpx; padding: 16rpx;
  position: relative;
}
.item-img { width: 160rpx; height: 160rpx; border-radius: 12rpx; flex-shrink: 0; }
.item-info { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.item-name { font-size: 26rpx; font-weight: 600; color: #1a1a1a; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.item-sub { font-size: 22rpx; color: #888; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.item-bottom { display: flex; align-items: center; justify-content: space-between; margin-top: auto; }
.item-price-wrap { display: flex; align-items: baseline; gap: 8rpx; }
.item-price { font-size: 30rpx; font-weight: 700; color: #c8391d; }
.item-ori { font-size: 22rpx; color: #bbb; text-decoration: line-through; }
.item-sales { font-size: 20rpx; color: #999; }
.item-add-btn {
  position: absolute; right: 20rpx; bottom: 20rpx;
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: #2d5a27; color: #fff;
  font-size: 32rpx; display: flex; align-items: center; justify-content: center;
}

.empty, .loading, .no-more { text-align: center; padding: 60rpx 0; color: #999; font-size: 24rpx; }
