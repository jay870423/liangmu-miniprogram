/* 分类页 */
.page { display: flex; height: 100vh; width: 100%; overflow-x: hidden; background: #f5f5f5; box-sizing: border-box; }

.left-panel { width: 172rpx; flex-shrink: 0; background: #f7f8f6; border-right: 1rpx solid #edf0ea; box-sizing: border-box; }
.left-scroll { height: 100vh; }
.cate-item { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; min-height: 112rpx; padding: 16rpx 10rpx; border-bottom: 1rpx solid #edf0ea; box-sizing: border-box; color: #465041; }
.cate-item.active { background: #fff; color: #2d5a27; font-weight: 700; }
.cate-item.active::before { content: ''; position: absolute; left: 0; top: 24rpx; bottom: 24rpx; width: 6rpx; border-radius: 0 8rpx 8rpx 0; background: #2d5a27; }
.cate-icon { width: 34rpx; height: 34rpx; flex-shrink: 0; }
.cate-icon-placeholder { font-size: 30rpx; line-height: 1; flex-shrink: 0; }
.cate-name { width: 100%; font-size: 24rpx; line-height: 1.25; text-align: center; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.right-panel { flex: 1; min-width: 0; display: flex; flex-direction: column; }
.right-hd {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 22rpx 18rpx 14rpx;
  background: #fff; border-bottom: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}
.right-title { flex: 1; min-width: 0; font-size: 28rpx; font-weight: 700; color: #1a1a1a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.right-count { flex-shrink: 0; font-size: 22rpx; color: #999; }

.right-scroll { flex: 1; min-height: 0; }
.product-list { width: 100%; box-sizing: border-box; padding: 16rpx 14rpx 28rpx; }
.list-item { width: 100%; box-sizing: border-box; display: flex; align-items: stretch; gap: 16rpx; background: #fff; border-radius: 16rpx; padding: 16rpx; margin-bottom: 16rpx; box-shadow: 0 4rpx 18rpx rgba(0,0,0,0.035); overflow: hidden; }
.item-img { width: 148rpx; height: 148rpx; border-radius: 12rpx; flex-shrink: 0; background: #f3f3f3; }
.item-info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.item-name { font-size: 26rpx; font-weight: 700; line-height: 1.35; color: #1a1a1a; word-break: break-all; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.item-sub { font-size: 22rpx; color: #888; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
.item-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 10rpx; margin-top: auto; }
.item-price-wrap { min-width: 0; display: flex; flex-direction: column; gap: 2rpx; }
.item-price { font-size: 30rpx; font-weight: 800; color: #c8391d; line-height: 1.2; word-break: break-all; }
.item-ori { font-size: 20rpx; color: #bbb; text-decoration: line-through; }
.item-side { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; }
.item-sales { max-width: 100rpx; font-size: 20rpx; color: #999; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.item-add-btn { width: 48rpx; height: 48rpx; border-radius: 50%; background: #2d5a27; color: #fff; font-size: 32rpx; line-height: 46rpx; display: flex; align-items: center; justify-content: center; box-shadow: 0 4rpx 12rpx rgba(45,90,39,.18); }

.empty, .loading, .no-more { text-align: center; padding: 60rpx 0; color: #999; font-size: 24rpx; }
