.page { background: #f4f6f2; min-height: 100vh; padding-bottom: 40rpx; }

.user-section {
  background: linear-gradient(180deg, #245724 0%, #2f6b2d 100%);
  padding: 52rpx 32rpx 34rpx;
}
.user-info { display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 120rpx; height: 120rpx; border-radius: 50%; border: 4rpx solid rgba(255,255,255,0.35); background: #e8ece5; }
.user-text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.nickname { font-size: 34rpx; font-weight: 800; color: #fff; }
.user-id { max-width: 460rpx; font-size: 20rpx; color: rgba(255,255,255,0.72); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.phone-text { font-size: 24rpx; color: rgba(255,255,255,0.88); }
.phone-bind-btn {
  align-self: flex-start;
  margin: 6rpx 0 0;
  padding: 0 28rpx;
  min-width: 220rpx;
  height: 48rpx;
  line-height: 48rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.18);
  color: #fff;
  font-size: 22rpx;
  border: 1rpx solid rgba(255,255,255,0.38);
}
.phone-bind-btn::after { border: 0; }

.user-stats {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
  background: rgba(255,255,255,0.13);
  border-radius: 14rpx;
  padding: 18rpx 0;
}
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4rpx; }
.stat-num { font-size: 34rpx; font-weight: 800; color: #fff; }
.stat-label { font-size: 22rpx; color: rgba(255,255,255,0.82); }
.stat-div { width: 1rpx; height: 48rpx; background: rgba(255,255,255,0.22); }

.order-bar,
.menu-section {
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 18rpx rgba(42, 80, 36, 0.06);
}
.section-hd {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx 6rpx;
}
.section-title { font-size: 30rpx; font-weight: 800; color: #1c241b; }
.section-link { font-size: 24rpx; color: #7b8b78; }
.order-tabs { display: flex; padding: 18rpx 10rpx 24rpx; }
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  position: relative;
}
.tab-icon-wrap {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  border-radius: 24rpx;
  background: #f1f6ef;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-icon { font-size: 30rpx; color: #2d5a27; font-weight: 800; }
.tab-name { font-size: 22rpx; color: #536250; }
.tab-badge {
  position: absolute;
  top: -8rpx;
  right: -12rpx;
  background: #c8391d;
  color: #fff;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 20rpx;
  min-width: 28rpx;
  text-align: center;
}

.menu-section { padding: 4rpx 0; }
.menu-item {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 10rpx 28rpx;
  border-bottom: 1rpx solid #f0f3ef;
}
.menu-item:active { background: #f8faf7; }
.menu-item:last-child { border-bottom: 0; }
.menu-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 22rpx;
  background: #f1f6ef;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}
.menu-icon { font-size: 28rpx; color: #2d5a27; font-weight: 800; }
.menu-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 6rpx; }
.menu-label { font-size: 28rpx; color: #1f2a1e; font-weight: 650; }
.menu-desc { font-size: 22rpx; color: #9aa399; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.menu-arrow { font-size: 42rpx; color: #c4c9c1; padding-left: 16rpx; line-height: 1; }

.logout-btn {
  margin: 28rpx 24rpx 0;
  background: #fff;
  color: #7b4a3c;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(42, 80, 36, 0.04);
}
