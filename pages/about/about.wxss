.page { min-height: 100vh; background: #f5f5f5; padding: 32rpx 24rpx; }
.brand {
  background: linear-gradient(135deg, #2d5a27, #3d7a37);
  color: #fff;
  border-radius: 22rpx;
  padding: 46rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 56rpx;
  background: rgba(255,255,255,0.16);
  border: 2rpx solid rgba(255,255,255,0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  font-weight: 800;
}
.name { font-size: 38rpx; font-weight: 800; }
.desc { font-size: 25rpx; color: rgba(255,255,255,0.82); text-align: center; line-height: 1.6; }
.panel { margin-top: 24rpx; background: #fff; border-radius: 16rpx; overflow: hidden; }
.row { padding: 28rpx; border-bottom: 1rpx solid #f0f0f0; display: flex; flex-direction: column; gap: 10rpx; }
.row:last-child { border-bottom: 0; }
.label { font-size: 24rpx; color: #888; }
.value { font-size: 28rpx; color: #1a1a1a; line-height: 1.6; }
.footer { padding: 60rpx 0; text-align: center; color: #999; font-size: 24rpx; }
