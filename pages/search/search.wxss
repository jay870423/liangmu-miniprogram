/* 搜索页 */
.page { background: #f5f5f5; min-height: 100vh; }
.search-bar { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx; background: #fff; }
.search-input { flex: 1; height: 64rpx; background: #f5f5f5; border-radius: 32rpx; padding: 0 24rpx; font-size: 26rpx; }
.search-btn { font-size: 28rpx; color: #2d5a27; font-weight: 600; }
.result-list { height: calc(100vh - 96rpx); }
.result-grid { display: flex; flex-wrap: wrap; gap: 16rpx; padding: 16rpx 24rpx; }
.result-item { width: calc(50% - 8rpx); background: #fff; border-radius: 16rpx; overflow: hidden; }
.result-img { width: 100%; height: 320rpx; }
.result-info { padding: 14rpx; }
.result-name { font-size: 26rpx; font-weight: 600; color: #1a1a1a; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.result-sub { font-size: 22rpx; color: #888; display: block; margin-top: 4rpx; }
.result-bottom { display: flex; justify-content: space-between; margin-top: 8rpx; }
.result-price { font-size: 28rpx; font-weight: 700; color: #c8391d; }
.result-sales { font-size: 20rpx; color: #999; }
.hot-search { padding: 24rpx; }
.hot-title { font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx; }
.hot-tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.hot-tag { background: #fff; color: #333; font-size: 24rpx; padding: 12rpx 24rpx; border-radius: 32rpx; }
.history-title { font-size: 28rpx; font-weight: 700; margin: 24rpx 0 16rpx; }
.history-list { display: flex; flex-wrap: wrap; gap: 12rpx; }
.history-item { background: #fff; color: #666; font-size: 24rpx; padding: 10rpx 20rpx; border-radius: 24rpx; }
.empty, .loading, .no-more { text-align: center; padding: 60rpx 0; }
.empty { display: flex; flex-direction: column; align-items: center; gap: 12rpx; font-size: 80rpx; }
.empty-txt { font-size: 28rpx; color: #999; }
.loading, .no-more { font-size: 24rpx; color: #999; }
