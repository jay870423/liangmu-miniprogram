<view class="page">
  <!-- 搜索框 -->
  <view class="search-bar">
    <input class="search-input" placeholder="搜索商品" value="{{keyword}}" bindinput="onInput" bindconfirm="onSearch" focus />
    <view class="search-btn" bindtap="onSearch">搜索</view>
  </view>

  <!-- 搜索结果 -->
  <scroll-view class="result-list" scroll-y wx:if="{{keyword}}">
    <view class="result-grid">
      <view class="result-item" wx:for="{{products}}" wx:key="id" bindtap="goProduct" data-id="{{item.id}}">
        <image class="result-img" src="{{item.main_image}}" mode="aspectFill" />
        <view class="result-info">
          <text class="result-name">{{item.name}}</text>
          <text class="result-sub">{{item.subtitle}}</text>
          <view class="result-bottom">
            <text class="result-price">¥{{item.price}}</text>
            <text class="result-sales">已售{{item.sales || 0}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="loading" wx:if="{{loading}}">加载中...</view>
    <view class="no-more" wx:if="{{loaded && !hasMore && products.length > 0}}">— 没有更多了 —</view>
    <view class="empty" wx:if="{{loaded && products.length === 0}}">
      <text>🔍</text><text class="empty-txt">未找到相关商品</text>
    </view>
  </scroll-view>

  <!-- 热门搜索 -->
  <view class="hot-search" wx:if="{{!keyword}}">
    <view class="hot-title">🔥 热门搜索</view>
    <view class="hot-tags">
      <view class="hot-tag" wx:for="{{hotKeywords}}" wx:key="index" bindtap="onHotTap" data-kw="{{item}}">{{item}}</view>
    </view>
    <view class="history-title" wx:if="{{history.length > 0}}">🕐 搜索历史</view>
    <view class="history-list" wx:if="{{history.length > 0}}">
      <view class="history-item" wx:for="{{history}}" wx:key="index" bindtap="onHistoryTap" data-kw="{{item}}">{{item}}</view>
    </view>
  </view>
</view>
