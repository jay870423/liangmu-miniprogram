.page { min-height: 100vh; background: #f5f5f5; }
.tabs { display: flex; background: #fff; border-bottom: 1rpx solid #eee; }
.tab { flex: 1; text-align: center; padding: 24rpx 0; font-size: 26rpx; color: #666; position: relative; }
.tab.active { color: #2d5a27; font-weight: 700; }
.tab.active::after { content: ''; position: absolute; left: 35%; right: 35%; bottom: 0; height: 4rpx; background: #2d5a27; border-radius: 4rpx; }
.list { height: calc(100vh - 90rpx); }
.coupon {
  display: flex;
  align-items: stretch;
  margin: 20rpx 24rpx 0;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
}
.amount {
  width: 180rpx;
  background: #2d5a27;
  color: #fff;
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding-top: 42rpx;
}
.symbol { font-size: 28rpx; }
.num { font-size: 56rpx; font-weight: 800; }
.detail { flex: 1; min-width: 0; padding: 24rpx; display: flex; flex-direction: column; gap: 8rpx; }
.name { font-size: 30rpx; font-weight: 700; color: #1a1a1a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rule, .date { font-size: 22rpx; color: #777; }
.receive, .state { width: 110rpx; display: flex; align-items: center; justify-content: center; font-size: 24rpx; }
.receive { color: #2d5a27; font-weight: 700; }
.state { color: #999; }
.coupon.disabled .amount { background: #a8a8a8; }
.coupon.disabled .name, .coupon.disabled .rule, .coupon.disabled .date { color: #999; }
.empty, .loading { text-align: center; padding: 100rpx 0; color: #999; }
.empty { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.empty-icon { font-size: 92rpx; }
.empty-text { font-size: 28rpx; }
