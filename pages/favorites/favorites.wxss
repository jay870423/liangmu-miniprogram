.page { min-height: 100vh; background: #f5f5f5; }
.list { height: 100vh; }
.card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 18rpx;
  background: #fff;
  border-radius: 16rpx;
}
.thumb { width: 150rpx; height: 150rpx; border-radius: 12rpx; flex-shrink: 0; background: #f1f1f1; }
.info { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.name { font-size: 28rpx; font-weight: 700; color: #1a1a1a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sub { font-size: 22rpx; color: #888; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.meta { display: flex; align-items: center; justify-content: space-between; margin-top: 8rpx; }
.price { font-size: 30rpx; font-weight: 700; color: #c8391d; }
.sales { font-size: 22rpx; color: #999; }
.remove {
  padding: 12rpx 18rpx;
  border-radius: 24rpx;
  background: #fff1f1;
  color: #d64242;
  font-size: 24rpx;
  flex-shrink: 0;
}
.empty, .loading, .no-more { text-align: center; padding: 80rpx 0; color: #999; font-size: 24rpx; }
.empty { display: flex; flex-direction: column; align-items: center; gap: 16rpx; }
.empty-icon { font-size: 88rpx; }
.empty-text { font-size: 28rpx; color: #999; }
