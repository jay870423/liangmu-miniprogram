.page { min-height: 100vh; background: #f5f5f5; padding: 20rpx 24rpx; }
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 16rpx;
}
.question { font-size: 30rpx; font-weight: 700; color: #1a1a1a; }
.answer { margin-top: 14rpx; font-size: 26rpx; color: #666; line-height: 1.7; }
.contact {
  margin-top: 24rpx;
  padding: 28rpx;
  background: #eaf6e8;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.contact-title { font-size: 28rpx; font-weight: 700; color: #2d5a27; }
.contact-text { font-size: 24rpx; color: #4f6f4a; line-height: 1.6; }
